<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zhicloud.module.infra.dal.mysql.file.FileMapper">

    <select id="selectLatestByConfigIdAndPathNoOrder" resultType="cn.zhicloud.module.infra.dal.dataobject.file.FileDO">
        SELECT * FROM infra_file
        WHERE deleted = 0
        AND config_id = #{configId}
        AND path = #{path}
        ORDER BY id DESC
        LIMIT 1
    </select>

</mapper>