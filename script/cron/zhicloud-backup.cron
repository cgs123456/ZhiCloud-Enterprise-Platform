# ====================================================================
# zhicloud 备份与容灾演练 cron 定时配置示例
#
# 部署方式（root 用户执行）：
#   sudo crontab -e
#   将下列内容追加，并替换 ZHICLOUD_HOME 为实际路径
#
# 或将本文件拷贝到 /etc/cron.d/zhicloud-backup 并设置 644 权限：
#   sudo cp script/cron/zhicloud-backup.cron /etc/cron.d/zhicloud-backup
#   sudo chmod 644 /etc/cron.d/zhicloud-backup
#   sudo systemctl reload cron
#
# 环境变量：
#   - 必须先在 /etc/profile.d/zhicloud-backup.env 或 root 的 .bashrc 中设置
#     MYSQL_PASSWORD / PG_PASSWORD / REDIS_PASSWORD 等敏感变量
#   - 或在 backup-config.sh 中通过其它安全方式注入
# ====================================================================

# ===== 路径与公共变量（请按实际环境修改）=====
# 项目根目录
ZHICLOUD_HOME=/data/projects/zhicloud
# 脚本路径
BACKUP_SCRIPT=${ZHICLOUD_HOME}/script/shell/backup-remote.sh
DRILL_SCRIPT=${ZHICLOUD_HOME}/script/shell/disaster-recovery-drill.sh
# 日志路径
BACKUP_CRON_LOG=/var/log/zhicloud-backup-cron.log
DRILL_CRON_LOG=/var/log/zhicloud-drill-cron.log
# PATH（cron 默认环境 PATH 较少，需补充 mysql/aws/java 客户端路径）
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/mysql/bin:/opt/aws-cli/bin

# ====================================================================
# 备份任务：每天凌晨 2:00 执行异地备份
# ====================================================================
0 2 * * * root ${BACKUP_SCRIPT} >> ${BACKUP_CRON_LOG} 2>&1

# ====================================================================
# 容灾演练：每周日凌晨 3:00 执行
# - 仅在周日运行，避免业务高峰
# - 如需更频繁的演练，可改为每月 1 号：0 3 1 * *
# ====================================================================
0 3 * * 0 root ${DRILL_SCRIPT} >> ${DRILL_CRON_LOG} 2>&1

# ====================================================================
# 可选：每月 1 号做一次完整备份归档（不删除旧备份）
# 0 4 1 * * root ${BACKUP_SCRIPT} --config=/path/to/archive-config.sh >> /var/log/zhicloud-archive-cron.log 2>&1
# ====================================================================

# ====================================================================
# 日志轮转建议（需 logrotate，单独配置 /etc/logrotate.d/zhicloud-backup）：
#   /var/log/zhicloud-backup-cron.log /var/log/zhicloud-drill-cron.log {
#       weekly
#       rotate 8
#       compress
#       missingok
#       notifempty
#       create 0644 root root
#   }
# ====================================================================
