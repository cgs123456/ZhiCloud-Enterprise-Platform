        {"datasource": "Prometheus", "expr": "histogram_quantile(0.5, sum(rate(jvm_gc_pause_seconds_bucket{application=~\"$application\"}[5m])) by (le, action)) * 1000", "legendFormat": "P50 - {{action}}", "range": true, "refId": "B"}
