<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.zhicloud</groupId>
        <artifactId>zhicloud</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>zhicloud-module-mes</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        mes 模块下，制造执行系统（Manufacturing Execution System）。
        例如说：基础数据、排班日历、设备管理、工具管理、生产管理、质量管理、仓库管理等等
    </description>

    <dependencies>
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- P1-4 共享库存 Starter：MES 通过 InventoryProjectionReader SPI 向共享真值源暴露库存投影（P1-1 日终对账） -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-biz-inventory</artifactId>
        </dependency>

        <!-- ERP 模块：ErpMrpExecutorGatewayImpl 反向 SPI 实现需引用 erp.api 包中的 SPI 接口与 ErpMpsPlanDO（P1-3 边界治理：跨模块契约经 erp.api 边界） -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-module-erp</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 业务组件：跨模块消费 QMS 质检结论（P0-3 完工入库卡点，仅依赖 api 包，禁止 import dal/service） -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-module-qms</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 业务组件 -->

        <!-- Web 相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- WebSocket 相关（P0-2 生产看板实时推送） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-test</artifactId>
        </dependency>

        <!-- A3 Spring Modulith：@ApplicationModule 注解依赖（compile-time only，runtime 由 zhicloud-server 提供） -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- JaCoCo 覆盖率门禁激活：引用父 pom 托管的 jacoco-maven-plugin（含 prepare-agent / report / check 执行），
         使本模块的 service 包纳入核心域覆盖率门禁（wms/mes/bpm service ≥ 0.40）。 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
