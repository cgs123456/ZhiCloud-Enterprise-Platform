<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.zhicloud</groupId>
        <artifactId>zhicloud</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>zhicloud-module-erp</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        erp 包下，企业资源管理（Enterprise Resource Planning）。
        例如说：采购、销售、库存、财务、产品等等
    </description>

    <dependencies>
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- P1-4 共享库存 Starter：ERP 通过 InventoryProjectionReader SPI 向共享真值源暴露库存投影（P1-1 日终对账） -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-biz-inventory</artifactId>
        </dependency>

        <!-- 业务组件 -->

        <!-- Web 相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-test</artifactId>
        </dependency>

        <!-- A3 Spring Modulith：@ApplicationModule 注解依赖（compile-time only，runtime 由 zhicloud-server 提供） -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>