# MySQL
MYSQL_DATABASE=zhicloud_platform
MYSQL_ROOT_PASSWORD=请修改为强密码

# Redis
REDIS_PASSWORD=请修改为强密码

# PostgreSQL (RAG)
POSTGRES_DB=yudao_rag
POSTGRES_USER=yudao
POSTGRES_PASSWORD=请修改为强密码

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=请修改为强密码

# yudao-server
SPRING_PROFILES_ACTIVE=local
MASTER_DATASOURCE_URL=jdbc:mysql://yudao-mysql:3306/zhicloud_platform?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=请修改为强密码
SLAVE_DATASOURCE_URL=jdbc:mysql://yudao-mysql:3306/zhicloud_platform?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
SLAVE_DATASOURCE_USERNAME=root
SLAVE_DATASOURCE_PASSWORD=请修改为强密码

# Alertmanager
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your-token

# Java
JAVA_OPTS=-Xms512m -Xmx512m -XX:+UseZGC -XX:+ZGenerational -Djava.security.egd=file:/dev/./urandom
