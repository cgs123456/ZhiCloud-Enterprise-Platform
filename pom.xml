<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>cn.iocoder.boot</groupId>
    <artifactId>yudao</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <modules>
        <module>yudao-dependencies</module>
        <module>yudao-framework</module>
        <!-- Server 主项目 -->
        <module>yudao-server</module>
        <!-- 各种 module 拓展 -->
        <module>yudao-module-system</module>
        <module>yudao-module-infra</module>
<!--        <module>yudao-member</module>-->
        <module>yudao-module-bpm</module> <!-- 启用：BPM 工作流（Flowable 8.0.0），CRM 依赖 -->
<!--        <module>yudao-module-report</module>-->
<!--        <module>yudao-module-mp</module>-->
<!--        <module>yudao-module-pay</module>-->
<!--        <module>yudao-module-mall</module>-->
        <module>yudao-module-crm</module> <!-- B5 启用：CRM 客户关系管理模块（商机/合同/跟进） -->
        <module>yudao-module-erp</module>
<!--        <module>yudao-module-iot</module>-->
        <module>yudao-module-mes</module>
        <module>yudao-module-wms</module>
        <module>yudao-module-qms</module> <!-- QMS 质量管理系统模块（IQC/IPQC/OQC/CAPA） -->
<!--        <module>yudao-module-im</module>-->
<!-- 请参考 https://github.com/cgs123456/ZhiCloud-Enterprise-Platform/docs/ai 文档，完成 AI 模块的启动！！！ -->
        <module>yudao-module-ai</module>
        <module>yudao-module-ai-rag</module>
        <module>yudao-module-ai-multiagent</module>
        <!-- 补充：yudao-server 依赖以下模块，需纳入构建 -->
        <module>yudao-module-tms</module> <!-- TMS 运输管理（承运商/车辆/司机/运单/跟踪） -->
        <module>yudao-module-datalake</module> <!-- 数据湖仓（Iceberg + Trino） -->
        <module>yudao-module-oa</module> <!-- OA 办公自动化（报销/会议室/公文） -->
        <module>yudao-module-hr</module> <!-- HR 人力资源（员工/部门/考勤/薪资/绩效） -->
    </modules>

    <name>${project.artifactId}</name>
    <description>智云企业数字化平台</description>
    <url>https://github.com/cgs123456/ZhiCloud-Enterprise-Platform</url>

    <properties>
        <revision>2026.06.0</revision>
        <!-- Maven 相关 -->
        <java.version>21</java.version> <!-- A1 升级：JDK 17 → 21 LTS，与本机 Temurin-21.0.11 对齐；后续可平滑切换到 JDK 25 LTS -->
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <flatten-maven-plugin.version>1.7.2</flatten-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version> <!-- JaCoCo 覆盖率插件：mvn verify 生成报告，目标 target/site/jacoco/index.html -->
        <jacoco.minimum>0.40</jacoco.minimum> <!-- JaCoCo 最低覆盖率基线（分阶段提升：0.40 → 0.60 → 0.80）；-Djacoco.minimum=0.00 可临时跳过。注意：check 规则通过 ${jacoco.minimum} 引用本属性，改这里即改门禁 -->
        <dependency-check-maven.version>12.2.2</dependency-check-maven.version> <!-- OWASP 依赖漏洞扫描；CI 门禁 failBuildOnCVSS=7 -->
        <nvd.api.key/> <!-- NVD API Key，本地留空；CI 通过 -Dnvd.api.key=${{ secrets.NVD_API_KEY }} 注入 -->
        <!-- maven-surefire-plugin 暂时无法通过 bom 的依赖读取（兼容老版本 IDEA 2024 及以前版本） -->
        <lombok.version>1.18.46</lombok.version>
        <spring.boot.version>3.5.16</spring.boot.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iocoder.boot</groupId>
                <artifactId>yudao-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- maven-surefire-plugin 插件，用于运行单元测试。 -->
                <!-- 注意，需要使用 3.0.X+，因为要支持 Junit 5 版本 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <!-- maven-compiler-plugin 插件，解决 spring-boot-configuration-processor + Lombok + MapStruct 组合 -->
                <!-- https://stackoverflow.com/questions/33483697/re-run-spring-boot-configuration-annotation-processor-to-update-generated-metada -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>21</release> <!-- A1 升级：JDK 17 → 21 LTS，与本机 Temurin-21.0.11 对齐；后续可平滑切换到 JDK 25 LTS -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring.boot.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <!-- 确保 Lombok 生成的 getter/setter 方法能被 MapStruct 正确识别，
                                     避免出现 No property named “xxx" exists 的编译错误 -->
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>0.2.0</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <!-- 编译参数写在 arg 内，解决 Spring Boot 3.2 的 Parameter Name Discovery 问题 -->
                        <debug>false</debug>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                </plugin>
                <!-- JaCoCo 覆盖率插件：mvn verify 生成报告 -->
                <!-- 使用方式：mvn clean verify -DskipTests=false -->
                <!-- 报告路径：target/site/jacoco/index.html（模块级）/ target/site/jacoco-aggregate/index.html（聚合） -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <!--
                          Phase 4 覆盖率门禁：将 check goal 绑定到 verify，对「已补齐单测的核心业务域」
                          强制指令覆盖率下限，避免回归。范围刻意只覆盖 wms/mes/bpm 的 service 包——
                          其余模块（crm/erp 等）单测尚在补齐中，纳入聚合会拉低基线从而误 brick CI。
                          随各模块单测补齐，逐步把其 service 包加入 <includes> 并上调 jacoco.minimum。
                        -->
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <!-- 覆盖率门禁（Phase 4）：仅对 wms/mes/bpm 的 service 包做指令覆盖率统计与强制下限。
                             顶层 <includes> 将「被插桩 + 被统计」的类收敛为上述 service 包；其余类（config/DO/VO/controller 等）
                             不参与统计，避免拉低基线误 brick。每个模块只含自己的 service 类，门禁按模块独立评估、互不干扰。
                             阈值取自 ${jacoco.minimum}（当前 0.40）；后续 crm/erp/ai/datalake/system/pay 补测达标后在此 <includes> 追加。

                             关键：BUNDLE 级 <rule> 的 <includes> 匹配的是「bundle 名称」而非类名，因此包级过滤必须放在
                             顶层 <includes>（作用于插桩/统计范围），BUNDLE 规则本身不再写 <includes>。 -->
                        <formats>
                            <format>HTML</format>
                            <format>XML</format>
                        </formats>
                        <includes>
                            <include>cn/iocoder/yudao/module/wms/service/**</include>
                            <include>cn/iocoder/yudao/module/mes/service/**</include>
                            <include>cn/iocoder/yudao/module/bpm/service/**</include>
                        </includes>
                        <haltOnFailure>true</haltOnFailure>
                        <rules>
                            <!-- 单条 BUNDLE 规则：对当前模块内「被统计的 service 类」整体求指令覆盖率，必须 ≥ 0.40。
                                 因顶层 <includes> 已把统计范围收敛到 service 包，BUNDLE 即等于该模块 service 聚合覆盖率。 -->
                            <rule>
                                <element>BUNDLE</element>
                                <limits>
                                    <limit>
                                        <counter>INSTRUCTION</counter>
                                        <value>COVEREDRATIO</value>
                                        <!-- 引用 ${jacoco.minimum} 属性，而非写死数值：
                                             此前这里硬编码 0.40，而 properties 里的 jacoco.minimum 无人引用，
                                             导致注释中承诺的 "-Djacoco.minimum=0.00 可临时跳过" 实际完全无效。 -->
                                        <minimum>${jacoco.minimum}</minimum>
                                    </limit>
                                </limits>
                            </rule>
                        </rules>
                    </configuration>
                </plugin>
                <!-- OWASP Dependency-Check：依赖漏洞扫描（CI 安全门禁，failBuildOnCVSS=7 阻断高危漏洞） -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check-maven.version}</version>
                    <configuration>
                        <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                        <!-- CVSS >= 7（高危及以上）阻断构建 -->
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <!-- NVD 自 2023 年起对匿名调用严格限流，必须携带 API Key 才能在 CI 时限内完成同步；
                             未配置 Key 时 CI 会跳过该步骤并给出 warning，而非伪装通过 -->
                        <nvdApiKey>${nvd.api.key}</nvdApiKey>
                        <nvdApiDelay>4000</nvdApiDelay>
                        <nvdValidForHours>24</nvdValidForHours>
                        <!-- 关闭 .NET 程序集分析器，避免 Linux Runner 上因缺少 dotnet 运行时产生噪声告警 -->
                        <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 统一 revision 版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 使用 huawei / aliyun 的 Maven 源，提升下载速度 -->
    <repositories>
        <repository>
            <id>huaweicloud</id>
            <name>huawei</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
        </repository>
        <repository>
            <id>aliyunmaven</id>
            <name>aliyun</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

</project>
