<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.zhicloud</groupId>
        <artifactId>zhicloud</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>zhicloud-module-fms</artifactId>

    <name>${project.artifactId}</name>
    <description>
        fms 模块下，财务管理系统（Financial Management System）。
        覆盖账套配置、科目/凭证/辅助核算主数据、凭证管理、账簿查询、期末结账与三大报表
    </description>

    <dependencies>
        <!-- 业务组件 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- 依赖 system 模块（用户/部门 API） -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>cn.zhicloud</groupId>
            <artifactId>zhicloud-spring-boot-starter-test</artifactId>
        </dependency>

        <!-- A3 Spring Modulith：@ApplicationModule 注解依赖（compile-time only，runtime 由 zhicloud-server 提供） -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
